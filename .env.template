# Database - Railway will auto-provide DATABASE_URL
DATABASE_URL=

# Redis - Optional, add Redis service in Railway for this
REDIS_URL=

# Security Keys - MUST CHANGE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-this
COOKIE_SECRET=your-super-secret-cookie-key-change-this

# CORS Configuration for Vercel Frontend
ADMIN_CORS=https://arbvault-clean-*.vercel.app,https://*.vercel.app
STORE_CORS=https://arbvault-clean-*.vercel.app,https://*.vercel.app

# Medusa Admin
MEDUSA_ADMIN_BACKEND_URL=https://your-app.railway.app

# Node Environment
NODE_ENV=production

# Port - Railway provides this automatically
PORT=9000

